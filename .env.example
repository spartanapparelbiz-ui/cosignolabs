# cosigno environment
# Every variable is optional in development: with none set, the app runs in
# demo mode (single demo user, in-memory store, deterministic offline planner)
# so the full approval loop works out of the box.

# --- Planner (the LLM behind the operator; server-side only, never exposed
#     to the client). PLANNER_API_KEY is the hosted-LLM provider API key.
#     PLANNER_MODEL_* are the model identifiers — the ONLY place model names
#     live. Both the default (fast) and premium planners are config, never
#     hardcoded in source. Example values (uncomment + set for your provider):
# PLANNER_API_KEY=sk-...
# PLANNER_MODEL_DEFAULT=<fast-model-id>
# PLANNER_MODEL_PREMIUM=<stronger-model-id>
PLANNER_API_KEY=
PLANNER_MODEL_DEFAULT=
PLANNER_MODEL_PREMIUM=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Upstash Redis (rate limits; REQUIRED in production) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile (beta form; secret REQUIRED in production) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cost circuit breaker (optional, default 1000 plans/day across all users) ---
COSIGNO_GLOBAL_DAILY_PLANS=

# --- Stripe (billing; absent → everyone on free, billing UI hidden) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from `npx tsx scripts/stripe-setup.ts` (never hardcode in source)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_ANNUAL=
# Return URL for checkout/portal (defaults to cosignolabs.com)
NEXT_PUBLIC_APP_URL=
