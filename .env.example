# cosigno environment
# Every variable is optional in development: with none set, the app runs in
# demo mode (single demo user, in-memory store, deterministic offline planner)
# so the full approval loop works out of the box.

# --- Planner (the LLM behind the operator; server-side only, never exposed
#     to the client). PLANNER_API_KEY is the hosted-LLM provider API key.
#     PLANNER_MODEL_* are the model identifiers — the ONLY place model names
#     live. Both the default (fast) and premium planners are config, never
#     hardcoded in source. Example values (uncomment + set for your provider):
# PLANNER_API_KEY=sk-...
# PLANNER_MODEL_DEFAULT=<fast-model-id>
# PLANNER_MODEL_PREMIUM=<stronger-model-id>
PLANNER_API_KEY=
PLANNER_MODEL_DEFAULT=
PLANNER_MODEL_PREMIUM=
# Optional base URL override for provider portability:
PLANNER_BASE_URL=
# Backward-compat (read for one release with a deprecation warning): the
# previous env names still work if the new ones are unset. Migrate to the
# PLANNER_* names above.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk ---
# Auth is our own branded /sign-in + /sign-up surface driven by Clerk's headless
# hooks — Clerk is the engine, the look is entirely cosigno. Only the
# publishable key is exposed to the client; the secret key stays server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Show the "continue with google" button on the auth screen. Off by default;
# set to 1 only once Google is enabled as a social connection in Clerk.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=

# --- Upstash Redis (rate limits; REQUIRED in production) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Integrations / Connections (third-party apps + custom MCP servers) ---
# Credential vault: a 32-byte key (base64 or hex) that encrypts every stored
# OAuth token / API key / MCP bearer at rest (AES-256-GCM). REQUIRED to connect
# anything in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATIONS_ENCRYPTION_KEY=
# GitHub connector (the reference OAuth app). Create an OAuth App at
# github.com/settings/developers with the callback URL:
#   <site>/api/connections/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional additional connectors — each is live only once its env is set.
# Callback for every provider is  <site>/api/connections/<provider>/callback
# The Google pair powers Gmail, Google Calendar AND Google Drive (one OAuth
# app, three connectors) — enable the gmail/calendar/drive scopes on its
# consent screen. Microsoft pair = an Azure app registration (Outlook).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- Cloudflare Turnstile (beta form; secret REQUIRED in production) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cost circuit breaker: hard daily ceiling on total planner (spend) calls
#     across ALL users. When exceeded, /api/command stops calling the model and
#     returns a friendly "beta capacity reached today" message. Default 500.
#     (COSIGNO_GLOBAL_DAILY_PLANS is still read for backward-compat.)
DAILY_PLAN_CAP=

# --- Stripe (billing; absent → everyone on free, checkout disabled) ---
# Without these, billing is off and everyone stays on free. Rest of the app
# works. From Stripe → Developers → API keys + Webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key (safe to expose): powers the embedded card checkout. Absent
# → checkout falls back to Stripe-hosted Checkout. From Stripe → API keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set to "0" to force the hosted-Checkout fallback even with a publishable key.
NEXT_PUBLIC_CHECKOUT_EMBEDDED=
# Price IDs from `npx tsx scripts/stripe-setup.ts` (never hardcode in source).
# Absent → paid plans can't be purchased.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_ANNUAL=
# Promotion coupons (Stripe coupon IDs; absent → that offer is simply off).
# STRIPE_COUPON_INTRO: $9 first month on pro-monthly (e.g. amount_off 2000,
#   duration=once) — auto-applied for first-time subscribers only.
# STRIPE_COUPON_RETENTION: 50% off next 2 months (percent_off=50, duration=
#   repeating, duration_in_months=2) — cancel-flow save, once per customer.
STRIPE_COUPON_INTRO=
STRIPE_COUPON_RETENTION=
# Return/base URL for checkout + portal + OG (defaults to cosignolabs.com).
# NEXT_PUBLIC_SITE_URL is an accepted alias.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# Background scheduler. A long random string; an external cron (e.g. a
# Netlify scheduled function or cron-job.org) POSTs with header
#   x-cron-secret: <this value>
# to BOTH endpoints:
#   /api/automations/tick   (hourly — recurring missions)
#   /api/missions/tick      (every 1-5 min — keeps durable missions moving
#                            while nobody has the app open)
# Unset = scheduler off. Missions still progress whenever their owner has
# the missions page open (the client drives the same engine).
CRON_SECRET=
