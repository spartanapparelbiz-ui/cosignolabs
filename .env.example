# cosigno environment
# Every variable is optional in development: with none set, the app runs in
# demo mode (single demo user, in-memory store, deterministic offline planner)
# so the full approval loop works out of the box.

# --- Anthropic (operator agent; server-side only, never exposed to client) ---
ANTHROPIC_API_KEY=
# COSIGNO_OPERATOR_MODEL=claude-sonnet-5

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Upstash Redis (rate limits; REQUIRED in production) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile (beta form; secret REQUIRED in production) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cost circuit breaker (optional, default 1000 plans/day across all users) ---
COSIGNO_GLOBAL_DAILY_PLANS=

# --- Stripe (billing stub in beta) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
